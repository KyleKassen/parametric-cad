": "front"}, {"kind": "bolt", "id": "B210_3", "x": 214.0, "y": 166.007, "catalog": "WGO30", "length": 20, "side": "front"}, {"kind": "bolt", "id": "B210_4", "x": 214.0, "y": 45.992, "catalog": "WGO30", "length": 20, "side": "front"}, {"kind": "bolt", "id": "OZ_1", "x": 335.1, "y": 161.2, "catalog": "WGU30", "length": 12, "side": "front"}, {"kind": "bolt", "id": "OZ_2", "x": 335.1, "y": 65.2, "catalog": "WGU30", "length": 12, "side": "front"}, {"kind": "bolt", "id": "OZ_3", "x": 228.9, "y": 161.2, "catalog": "WGU30", "length": 12, "side": "front"}, {"kind": "bolt", "id": "OZ_4", "x": 228.9, "y": 65.2, "catalog": "WGU30", "length": 12, "side": "front"}, {"kind": "bolt", "id": "CARRIER_1", "x": 52.0, "y": 10.0, "catalog": "WGO30", "length": 20, "side": "front"}, {"kind": "bolt", "id": "CARRIER_2", "x": 52.0, "y": 204.0, "catalog": "WGO30", "length": 20, "side": "front"}, {"kind": "bolt", "id": "CARRIER_3", "x": 192.0, "y": 10.0, "catalog": "WGO30", "length": 20, "side": "front"}, {"kind": "bolt", "id": "CARRIER_4", "x": 192.0, "y": 204.0, "catalog": "WGO30", "length": 20, "side": "front"}], "save": "C:/Users/KyleKassen/Documents/FPE_SCE20_20260909_R2/Backpanel_R2.fpd", "remark": "R2 compact stacked layout. Original431.8square outline/R6.35 and6factoryholes.12M3 LOAD studsL12 +8M3female LOAD standoffsL20,allFRONT,offset0. Raised supports require separate Wurth971300321(4) and971500321(4) extension columns. Bedrock remains directly against panel. See R2 assembly and ordering notes; not load/thermal qualification."});
