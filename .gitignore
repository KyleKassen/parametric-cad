# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# CadQuery exports (generated artifacts - regenerate from scripts)
**/exports/attempts/
**/exports/*_report.json
**/exports/*_views/

# lib/render_step.py and lib/analyze_step.py write BESIDE the file they read, so
# rendering or analysing a PROMOTED artifact under exports/ creates
# parts/<group>/<part>/exports/references/{product,views}/ rather than the part's
# own references/. That is exactly what the cad-part-design skill instructs, and
# the PNGs and analysis JSON in it are derived artifacts like every other export.
**/exports/references/
**/exports/*.tmp
**/exports/*.step
**/exports/*.stp
**/exports/*.stl
**/exports/*.gltf
**/exports/*.glb
**/exports/*.amf
**/exports/*.3mf
**/exports/*.dxf
**/exports/*.svg

# IDE
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# pytest
.pytest_cache/

# ruff
.ruff_cache/

# Agent scratch space (throwaway scripts, probe renders). Both spellings: the
# working rule is "scratch in the repo's own tmp/scratch/ or scratch/", and only
# the first of the two was ever covered, so a top-level scratch/ full of probe
# scripts and STEP dumps sat untracked-but-visible in every status.
tmp/scratch/
scratch/

# `make diff` writes its overlay PNGs here, at the repo root, with no --out knob
renders/
